# === 楽天 ===
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
# テストフォームに自動入力されていたAccess key (アプリ詳細画面からコピー。チャットには貼らない)
RAKUTEN_ACCESS_KEY=
# API送信用Referer/Origin。許可されたWebサイトとスキーム含め完全一致 (登録が example.com なら http)
RAKUTEN_REFERER=http://example.com
# === Amazon PA-API v5 (なくても動作する。あると価格・画像が正確) ===
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=xxx-22
AMAZON_REGION=us-east-1
AMAZON_HOST=webservices.amazon.co.jp
AMAZON_MARKETPLACE=www.amazon.co.jp
# === X (なくてもSNS原稿は data/sns_queue に保存される) ===
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
# === サイト ===
SITE_URL=https://example.com
SITE_NAME=コスメ自動比較
